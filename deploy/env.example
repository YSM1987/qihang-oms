# =====================================================================
# 启航 OMS 非交互安装环境变量示例（对齐 3x-ui .env.example / deploy/README 模式）
# 用法：cp env.example qihang.env && 按需修改，然后：
#   set -a; . ./qihang.env; set +a; QIHANG_NONINTERACTIVE=1 bash install.sh
# 或直接内联：QIHANG_NONINTERACTIVE=1 GITHUB_REPO=... DOMAIN=... bash install.sh
# =====================================================================

# 必填：GitHub 仓库（Release 产物来源）
GITHUB_REPO=yourname/qihang-oms

# 必填：访问域名（Nginx server_name；仅 IP 访问填 "_"）
DOMAIN=oms.example.com

# 可选：后端端口（默认 8086，仅本机 Nginx 访问）
APP_PORT=8086

# 可选：对外访问端口（Nginx 监听，默认 30545；甲骨文安全列表须放行该端口）
WEB_PORT=30545

# 可选：MySQL 应用账号密码（缺省自动生成强密码）
# DB_PASSWORD=YourStrongPassword

# 可选：Redis 密码（缺省自动生成强密码）
# REDIS_PASSWORD=YourStrongPassword

# 可选：私有仓库只读 PAT（classic，勾选 repo；公共仓库无需）
# 也可 echo "ghp_xxx" > /root/.qihang_deploy_token
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# 非交互开关（stdin 非 TTY 时自动启用，无需显式设置）
# QIHANG_NONINTERACTIVE=1
